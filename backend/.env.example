# Copie para backend/.env e preencha com os dados do seu banco PostgreSQL (Supabase)
DB_USER=postgres.seu_projeto
DB_PASS=sua_senha
DB_HOST=aws-0-regiao.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres

# Recomendado em produção: certificado da CA do Supabase (Settings > Database > SSL Configuration > Download certificate).
# Cole o conteúdo do .crt entre aspas, com \n no lugar das quebras de linha. Sem ele, a conexão é criptografada
# mas o certificado do servidor não é verificado.
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
